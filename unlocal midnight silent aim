                            and Color3.fromRGB(70, 150, 255)
                            or Color3.fromRGB(255, 75, 75)
                        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                        highlight.Parent = character
                    end
                elseif existing then
                    existing:Destroy()
                end
            end
        end
    end
end

