-- HELPERS

local function tween(obj, duration, properties)
    local t = TweenService:Create(
        obj,
        TweenInfo.new(duration, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        properties
    )
    t:Play()
    return t
end

local function create(class, properties, parent)
    local obj = Instance.new(class)

    for k, v in pairs(properties or {}) do
        obj[k] = v
    end

    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    local corner = create("UICorner", {
        CornerRadius = UDim.new(0, radius or 9)
    }, obj)

    return corner
end

local function outline(obj, color, thickness)
    return create("UIStroke", {
        Color = color or C.Border,
        Thickness = thickness or 1,
        Transparency = 0.2,
    }, obj)
end

local function makeText(parent, value, position, size, fontSize, color, font)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = value,
        Position = position,
        Size = size,
        Font = font or Enum.Font.GothamMedium,
        TextSize = fontSize or 12,
        TextColor3 = color or C.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, parent)
end

local function cloneSettings(source)
    local copy = {}

    for k, v in pairs(source) do
        copy[k] = v
    end

    return copy
end

local function resetSettings()
    settings = cloneSettings(defaults)
end

local function saveConfig(slot)
    slot = math.clamp(math.floor(tonumber(slot) or 1), 1, 3)

    configs[slot] = cloneSettings(settings)
    currentConfig = slot
end

local function loadConfig(slot)
    slot = math.clamp(math.floor(tonumber(slot) or 1), 1, 3)

    if not configs[slot] then
        return false
    end

    settings = cloneSettings(configs[slot])
    currentConfig = slot

    return true
end

