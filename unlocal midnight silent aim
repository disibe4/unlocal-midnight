-- OPEN / CLOSE

local function openMenu()
    if opened or busy then return end

    opened = true
    busy = true

    main.Visible = true
    overlay.Visible = true

    mainScale.Scale = settings.MenuAnimation and 0.88 or 1
    overlay.BackgroundTransparency = 1

    if settings.MenuAnimation then
        tween(overlay, 0.24, {
            BackgroundTransparency = 0.35,
        })

        local animation = tween(mainScale, 0.28, {
            Scale = 1,
        })

        animation.Completed:Once(function()
            busy = false
        end)
    else
        mainScale.Scale = 1
        overlay.BackgroundTransparency = 0.35
        busy = false
    end
end

local function closeMenu()
    if not opened or busy then return end

    opened = false
    busy = true

    if settings.MenuAnimation then
        tween(overlay, 0.18, {
            BackgroundTransparency = 1,
        })

        local animation = tween(mainScale, 0.18, {
            Scale = 0.88,
        })

        animation.Completed:Once(function()
            if not opened then
                main.Visible = false
                overlay.Visible = false
            end

            busy = false
        end)
    else
        main.Visible = false
        overlay.Visible = false
        busy = false
    end
end

close.Activated:Connect(closeMenu)

UIS.InputBegan:Connect(function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.RightShift then
        if opened then
            closeMenu()
        else
            openMenu()
        end
    end
end)

