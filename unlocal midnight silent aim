local function render(name)
    if pageBusy or name == currentPage then
        return
    end

    pageBusy = true

    local out = tween(content, 0.11, {
        Position = UDim2.fromOffset(38, 81),
    })

    out.Completed:Wait()

    renderContent(name)
    currentPage = name

    content.Position = UDim2.fromOffset(8, 81)

    local incoming = tween(content, 0.23, {
        Position = UDim2.fromOffset(22, 81),
    })

    for page, button in pairs(navButtons) do
        local selected = page == name

        tween(button, 0.16, {
            BackgroundColor3 = selected and C.Element or C.Sidebar,
            TextColor3 = selected and C.Bright or C.Muted,
        })
    end

    incoming.Completed:Wait()
    pageBusy = false
end

