-- TOGGLE ROW

local function toggleRow(title, description, key, refreshCallback)
    local f = card(65)

    makeText(f, title,
        UDim2.fromOffset(14, 8),
        UDim2.new(1, -85, 0, 20),
        11, C.Text, Enum.Font.GothamSemibold)

    makeText(f, description,
        UDim2.fromOffset(14, 30),
        UDim2.new(1, -90, 0, 18),
        9, C.Muted)

    local switch = create("TextButton", {
        Position = UDim2.new(1, -57, 0.5, -11),
        Size = UDim2.fromOffset(42, 22),
        BackgroundColor3 = settings[key] and C.Purple or C.Element,
        Text = "",
        BorderSizePixel = 0,
        AutoButtonColor = false,
    }, f)

    round(switch, 12)

    local knob = create("Frame", {
        Position = settings[key]
            and UDim2.fromOffset(22, 3)
            or UDim2.fromOffset(3, 3),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = C.White,
        BorderSizePixel = 0,
    }, switch)

    round(knob, 10)

    local function refresh()
        tween(switch, 0.18, {
            BackgroundColor3 = settings[key] and C.Purple or C.Element,
        })

        tween(knob, 0.18, {
            Position = settings[key]
                and UDim2.fromOffset(22, 3)
                or UDim2.fromOffset(3, 3),
        })

        if refreshCallback then
            refreshCallback()
        end
    end

    switch.Activated:Connect(function()
        settings[key] = not settings[key]
        refresh()
    end)

    return refresh
end

-- SLIDER ROW

local function sliderRow(title, key, minValue, maxValue)
    local f = card(78)

    local valueText = makeText(f,
        title .. "     " .. tostring(settings[key]),
        UDim2.fromOffset(14, 8),
        UDim2.new(1, -28, 0, 20),
        11, C.Text, Enum.Font.GothamSemibold)

    local bar = create("Frame", {
        Position = UDim2.fromOffset(14, 48),
        Size = UDim2.new(1, -28, 0, 6),
        BackgroundColor3 = C.Element,
        BorderSizePixel = 0,
    }, f)

    round(bar, 5)

    local ratio = math.clamp(
        (settings[key] - minValue) / (maxValue - minValue),
        0, 1
    )

    local fill = create("Frame", {
        Size = UDim2.new(ratio, 0, 1, 0),
        BackgroundColor3 = C.Purple,
        BorderSizePixel = 0,
    }, bar)

    round(fill, 5)

    local hit = create("TextButton", {
        Position = UDim2.fromOffset(0, -12),
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, bar)

    local dragging = false

    local function update(x)
        local alpha = math.clamp(
            (x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1),
            0, 1
        )

        local value = math.floor(
            minValue + alpha * (maxValue - minValue) + 0.5
        )

        settings[key] = value

        tween(fill, 0.08, {
            Size = UDim2.new(alpha, 0, 1, 0),
        })

        valueText.Text = title .. "     " .. tostring(value)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input.Position.X)
        end
    end)

    local moveConnection
    moveConnection = UIS.InputChanged:Connect(function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            update(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

